# Cadena de conexión PostgreSQL (asyncpg). El dialecto "+asyncpg" es opcional:
# la app lo normaliza automáticamente.
DATABASE_URL=postgresql://usuario:password@localhost:5432/mercury

# Clave de firma de los JWT. Cambiar en producción.
SECRET_KEY=cambia-esto-en-produccion

# Orígenes permitidos para CORS (separados por comas).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
